# ====================================================
# QuantEngine -- example operator configuration.
#
# Copy to `.env` and fill in locally. NEVER commit a real
# `.env`: it is untracked by design (.gitignore covers
# `.env` / `.env.*`) and NEVER put replacement credentials
# into the repository -- provision them only via the local
# environment / deployment secret store.
#
# Paper mode needs NO credentials. LIVE execution additionally
# requires the Phase 11A gate (mode == LIVE, ALLOW_LIVE=true,
# LIVE_EXECUTE=true, authenticated Delta credentials).
# ====================================================

# Select both venue region and environment explicitly before using a private client.
# Keep the matching credential pair empty until provisioned locally.
# Change DELTA_REGION to INDIA when using an India account.
DELTA_REGION=GLOBAL
DELTA_ENVIRONMENT=

# Global production credentials
DELTA_API_KEY=
DELTA_API_SECRET=

# Global demo/testnet credentials
DELTA_SANDBOX_API_KEY=
DELTA_SANDBOX_API_SECRET=

# India production credentials
DELTA_INDIA_API_KEY=
DELTA_INDIA_API_SECRET=

# India demo/testnet credentials
DELTA_INDIA_SANDBOX_API_KEY=
DELTA_INDIA_SANDBOX_API_SECRET=

SYMBOLS=BTCUSDT,ETHUSDT
TIMEFRAME=1m
PAPER_MODE=True
LIVE_MODE=False
ALLOW_LIVE=
LIVE_EXECUTE=
EXECUTION_MODE=
MAX_OPEN_TRADES=1
RISK_PER_TRADE=1.0
HISTORICAL_CANDLES=500
LOG_LEVEL=INFO
UNIVERSE=explicit
